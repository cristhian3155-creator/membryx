# Copiar como .env y completar. Nunca commitear .env con valores reales.

# --- Negocio / configuracion ---
BUSINESS_NAME="Gimnasio Demo"
BUSINESS_TIMEZONE=America/Bogota
CURRENCY=COP
ENVIRONMENT=demo
APP_BASE_URL=http://localhost:3000

REMINDER_DAYS=3,2,1,0

MONTHLY_DURATION_DAYS=30
QUARTERLY_DURATION_DAYS=90
SEMESTER_DURATION_DAYS=180
ANNUAL_DURATION_DAYS=365

MONTHLY_PRICE_CENTS=8000000
QUARTERLY_PRICE_CENTS=21000000
SEMESTER_PRICE_CENTS=39000000
ANNUAL_PRICE_CENTS=72000000

PAYMENT_PROVIDER=wompi
WHATSAPP_PROVIDER=meta

# --- Base de datos ---
DATABASE_URL="postgresql://user:password@localhost:5432/membryx?schema=public"

# --- Wompi (Sandbox en DEMO) ---
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Twilio WhatsApp (alternativa; solo si WHATSAPP_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Meta WhatsApp Cloud API (solo si WHATSAPP_PROVIDER=meta) ---
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_API_VERSION=v21.0

# --- Dashboard admin ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=change-me-in-production
